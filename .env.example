# Chave secreta criada no painel do Resend.
RESEND_API_KEY=re_substitua_pela_chave

# Remetente autorizado no Resend. Em produção, use um domínio verificado.
RESEND_FROM_EMAIL="Save Soluções <site@seudominio.com.br>"

# Destinatário inicial de teste. Para trocar pelo e-mail da Save, altere só este valor.
RESEND_TO_EMAIL=seu-email-de-teste@exemplo.com
